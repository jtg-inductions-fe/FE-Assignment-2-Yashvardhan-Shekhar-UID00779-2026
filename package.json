{
    "name": "Vinces - smarter restaurant management",
    "description": "Vinces - a single, unified web platform that seamlessly serves both audiences. The application must intelligently identify the user's role upon login and dynamically adapt the available actions on the exact same screens. Customers use the interface to discover food and place orders, while restaurant owners use the very same pages to manage their menus and process incoming orders",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "build:dev": "tsc -b && vite build --mode development",
        "lint": "eslint --fix .",
        "lint:fix": "eslint --fix .",
        "preview": "vite preview",
        "prettier": "npx prettier --write ./",
        "postinstall": "husky install"
    },
    "dependencies": {
        "@emotion/react": "11.14.0",
        "@emotion/styled": "11.14.0",
        "@fontsource/inter": "^5.3.0",
        "@mui/icons-material": "6.4.1",
        "@mui/material": "6.4.1",
        "@reduxjs/toolkit": "^2.12.0",
        "@types/react-redux": "^7.1.34",
        "react": "19.0.0",
        "react-dom": "19.0.0",
        "react-hook-form": "^7.85.0",
        "react-redux": "^9.3.0"
    },
    "devDependencies": {
        "@types/eslint-plugin-jsx-a11y": "6",
        "@types/node": "22.10.7",
        "@types/react": "^19.2.18",
        "@types/react-dom": "19.0.3",
        "@vitejs/plugin-react": "4.3.4",
        "eslint": "9.18.0",
        "eslint-config-prettier": "10.0.1",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-react": "7.37.4",
        "eslint-plugin-react-hooks": "5.1.0",
        "eslint-plugin-react-refresh": "0.4.18",
        "eslint-plugin-simple-import-sort": "12.1.1",
        "globals": "15.14.0",
        "husky": "9.1.7",
        "lint-staged": "15.4.1",
        "prettier": "3.4.2",
        "sharp": "0.33.5",
        "terser": "5.37.0",
        "typescript": "5.7.3",
        "typescript-eslint": "8.21.0",
        "vite": "6.0.11",
        "vite-plugin-image-optimizer": "1.1.8",
        "vite-tsconfig-paths": "5.1.4"
    }
}
